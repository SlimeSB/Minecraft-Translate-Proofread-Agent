{
  "_comment": "翻译审校配置文件。多行文本可用字符串数组（运行时 \\n join），修改后无需改代码。",

  "pipeline": {
    "max_workers": 4,
    "filter_batch_size": 25,
    "review_batch_size": 50,
    "fts_recall_multiplier": 10,
    "fts_recall_min": 50,
    "fuzzy_trigger_patterns": [".desc", "death.", "advancements."],
    "format_specifier_pattern": "^%[a-zA-Z0-9_.$]+$",
    "word_extract_pattern": "[A-Za-z]{3,}",
    "singleton_length_threshold": 2000,
    "default_namespace_label": "其他",
    "vanilla_dict": {
      "per_word_trigger_words": ["block", "blocks", "item", "items"],
      "fuzzy_trigger_words": ["desc"],
      "word_count_threshold": 6,
      "vd_similarity_threshold": 60.0
    }
  },

  "manual_formats": {
    "ae2guide": {
      "label": "模组文档",
      "dir_name": "ae2guide"
    }
  },

  "llm": {
    "max_retries": 5,
    "temperature": 0.1,
    "max_tokens": 32768,
    "review_retries": 2,
    "system_prompt": "你是一位Minecraft模组简中翻译审校专家。请按要求输出JSON。",
    "header_prefix": "你是Minecraft模组简中翻译审校专家",
    "default_review_focus": "翻译需准确自然; 术语一致; 匹配语境",
    "review_instruction": [
      "对每条输出: {\"key\": \"条目的key值\", \"verdict\": \"PASS/⚠️ SUGGEST/🔶 REVIEW/❌ FAIL\", \"suggestion\": \"建议译文或空字符串\", \"reason\": \"审校理由\"}",
      "PASS条目不输出。仅输出JSON数组。key字段请使用条目中key字段的值（如 gui.crazyae2addons.save），不得编造或使用#1、#2等序号。"
    ],
    "review_principles": [
      "- 以原文为准,逐词理解后评价译文",
      "- 禁止过度发挥,风格差异过大标记🔶 REVIEW或❌ FAIL",
      "- 禁止不适烂梗,直接❌ FAIL",
      "- 专有名词保留原文不翻译",
      "- 检查语气是否匹配原文"
    ],
    "keyboard_guidance": "检测到预设的键盘按键，建议保留原文。",
    "mouse_guidance": "检测到鼠标操作，注意使用\"左键点击\"、\"右击\"、\"按住右键\"等，而非\"左键\"、\"右键\"",
    "dict_store_headers_to_strip": ["外部词典：", "原版词典："],
    "filter": {
      "system_prompt": "你是Minecraft模组翻译审校专家。请对每条问题逐条判断是否驳回。",
      "instruction": [
        "对每条问题输出一个JSON对象:",
        "- 驳回: {\"key\": \"key值\", \"verdict\": \"PASS\", \"reason\": \"驳回理由\"}",
        "- 保留: {\"key\": \"key值\", \"verdict\": \"条目原判定（如 ⚠️ SUGGEST）\", \"reason\": \"清洗后的中文问题描述\"}",
        "每条都必须输出，不得遗漏。仅输出JSON数组。",
        "",
        "判定标准：",
        "- 术语不一致但上下文合理 → PASS",
        "- 值相同但确为无需翻译的代码/数字/占位符 → PASS",
        "- 标点/空格问题对玩家体验无实际影响 → PASS",
        "- 自动检查建议「加空格」但中文排版无需 → PASS",
        "- 真正的翻译错误（漏译、误译、语气不匹配）→ 保留",
        "- 尾部空格不一致可能影响布局 → 保留",
        "",
        "保留条目的reason须：",
        "- 合并去重：同类问题合并为一句，去掉冗余标签",
        "- 简洁准确：一段话讲清楚，不重复、不自相矛盾",
        "- 去除自动检查套话（如「值相同」「疑似未翻译」），改写为自然语言"
      ]
    },
    "prompt_templates": {
      "review_full_header": [
        "{header_prefix}。",
        "",
        "## 审查重点",
        "{focus_notes}",
        "",
        "## 普适原则",
        "{review_principles}",
        "",
        "## PR 模式审校指南",
        "{change_context}",
        "",
        "跨版本引用说明：条目中的 ref_version 表示相邻高版本的现有译法。当当前版本与 ref_version 的翻译存在差异时，请判断该差异是否因原文变化或术语调整而合理——若非合理差异，应指出不一致问题。",
        "",
        "## 待审条目 ({count}条)",
        "{review_instruction}",
        "",
        "## 输入设备翻译专项指南",
        "{keyboard_guidance}",
        "{mouse_guidance}"
      ],
      "reference_section": "## 参考信息\n\n{sections}",
      "glossary_section": "### 术语表\n{glossary_entries}",
      "fuzzy_section": "### 模糊匹配\n{fuzzy_entries}",
      "dict_section": "{dict_heading}\n{dict_entries}",
      "cross_version_ref_block": [
        "",
        "跨版本参考:",
        "  ref_version: {ref_version}",
        "{ref_extra}"
      ],
      "auto_check_line": "  自动检查: {verdict} — {reason}",
      "entry_key_line": "key: `{key}`",
      "entry_en_line": "{en_label}: \"{en}\"",
      "entry_old_en_line": "old_en: \"{old_en}\"",
      "entry_old_zh_line": "old_zh: \"{old_zh}\"",
      "entry_ref_en_line": "  ref_en: \"{ref_en}\"",
      "entry_ref_zh_line": "  ref_zh: \"{ref_zh}\"",
      "entry_en_context_label": "EN (完整上下文)",
      "entry_zh_context_label": "ZH (完整上下文)",
      "entry_en_label": "EN",
      "entry_zh_label": "ZH",
      "glossary_term_line": "\"{en}\" → \"{zh}\"",
      "fuzzy_match_line": "[{key}] sim={similarity}% | EN: \"{en}\" | ZH: \"{zh}\"",
      "header_with_refs": "{header}\n\n{references}",
      "filter_entry_block_with_suggestion": "{block}\n{suggestion}",
      "filter_prompt_assembly": "{header}{instruction}\n\n{entry_blocks}",
      "untranslated_entry_block": "key: `{key}`\nEN: \"{en}\"\nZH: \"{zh}\"",
      "external_dict_heading": "### 词典",
      "vanilla_terms_heading": "### 原版词典",
      "minecraft_dict_heading": "### 原版翻译",
      "minecraft_dict_fuzzy_label": "模糊匹配：",
      "block_separator": "\n\n",
      "term_verification_prompt": [
        "你是Minecraft模组翻译术语专家。请校验以下自动提取的术语表。",
        "自动术语表从多个模组统计提取，可能存在错误。",
        "判断每条术语译文是否合适，不合适给出修正。",
        "输出JSON: [{{\"en\":\"原文\",\"old_zh\":\"原中文\",\"new_zh\":\"修正或原中文\",\"reason\":\"理由\"}}]",
        "仅输出需要修正的。仅输出JSON数组。",
        "",
        "{term_blocks}"
      ],
      "term_verification_term_line": "Term: \"{en}\" -> \"{zh}\"\n",
      "term_verification_context_line": "  [{index}] \"{en}\" -> \"{zh}\"\n",
      "external_dict_output": "外部词典: \n{entries}",
      "minecraft_dict_header": "原版词典：",
      "minecraft_dict_sensitive_warning": "存在版本敏感译名，不同版本存在差异。",
      "minecraft_dict_output": "{dict_header}{sensitive_warning}{sub_label}\n{body}",
      "filter_header": [
        "## 任务",
        "以下是自动检查和LLM审校后汇总的翻译问题列表。请逐条判断每条是否需要驳回（不提出），需要保留的清洗其问题描述。",
        "",
        "## 问题列表 ({count}条)"
      ],
      "filter_entry_block": [
        "key: `{key}`",
        "EN: \"{en}\"",
        "ZH: \"{zh}\"",
        "判定: {verdict}",
        "问题: {reason}"
      ],
      "filter_entry_suggestion": "建议: {suggestion}",
      "untranslated_prompt": [
        "你是Minecraft模组翻译审校专家。以下条目的英文和中文值相同（或高度相似），请判断是否确实为未翻译，还是合法的不需翻译的内容。",
        "",
        "## 判定标准",
        "- 原文为自然语言文本（单词、短语、句子），中文本应翻译但没有翻译 → 确实未翻译，判定 ❌ FAIL 并给出建议译文",
        "- 原文为代码、版本号、数字、URL路径、占位符、专有名词、色彩代码、命令参数等，中英一致是合理的 → 合法不需翻译，判定 PASS",
        "",
        "## 输出格式",
        "对每条输出: {{\"key\": \"条目的key值\", \"verdict\": \"PASS/❌ FAIL\", \"suggestion\": \"建议译文或空字符串\", \"reason\": \"判定理由\"}}",
        "每条都必须输出，不得遗漏。仅输出JSON数组。",
        "",
        "## 条目 ({count}条)",
        "",
        "{entry_blocks}",
        "仅输出JSON数组。"
      ]
    }
  },

  "terminology": {
    "min_freq": 3,
    "min_consensus": 0.6,
    "max_zh_len": 40,
    "max_en_len": 60,
    "consensus_min_total": 3,
    "max_ngram": 3,
    "max_keys_per_term": 20,
    "max_keys_raw": 100,
    "blacklist": [
      "the", "a", "an", "of", "to", "in", "and", "is", "it", "you",
      "this", "that", "will", "be", "can", "with", "for", "on", "are",
      "as", "at", "or", "not", "but", "from", "by", "has", "have",
      "had", "do", "does", "did", "your", "its", "they", "their", "each",
      "all", "some", "when", "if", "then", "also", "just", "now",
      "only", "out", "been", "was", "were", "into", "than", "no",
      "so", "up", "down", "here", "there", "over", "under", "block",
      "spawn", "egg", "potion", "one", "enable", "back", "rotate", "output", "item","Shift",
      "other", "another", "any", "use"
    ]
  },

  "format": {
    "desc_key_suffixes": [
      ".desc", ".description", ".lore", ".tooltip",
      ".flavor", ".info", ".message", ".text"
    ],
    "punctuation_spacing_whitelist": ["book.", "patchouli."],
    "en_preview_len": 60
  },

  "pr": {
    "change_context_prompt": "这是一个 PR review，每个人翻译风格不一样，注意审查不必要的更改。",
    "default_repo": "CFPAOrg/Minecraft-Mod-Language-Package"
  }
}
